{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adonai.example/schemas/trade-task-envelope.v1.json",
  "title": "Adonai Trade Task Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "correlation_id",
    "task_id",
    "requested_by",
    "market",
    "task_type",
    "mode",
    "created_at",
    "expires_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "requested_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "market": {
      "enum": [
        "B3",
        "INTERNATIONAL",
        "CRYPTO",
        "FOREX"
      ]
    },
    "task_type": {
      "enum": [
        "market_research",
        "analyze_instrument",
        "paper_order_proposal",
        "portfolio_risk_check",
        "news_digest",
        "health_check"
      ]
    },
    "mode": {
      "const": "paper"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "data_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "maxLength": 128
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "license_reference": {
          "type": "string",
          "maxLength": 512
        },
        "data_quality": {
          "enum": [
            "verified",
            "partial",
            "stale",
            "invalid",
            "unknown"
          ]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "scientific_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "maxLength": 256
        },
        "baseline": {
          "type": "string",
          "maxLength": 256
        },
        "uncertainty": {
          "type": "string",
          "maxLength": 1024
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          },
          "maxItems": 30
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "horizon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "enum": [
                "minute",
                "hour",
                "day",
                "week"
              ]
            }
          }
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "calibration_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "calibration_window": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "calibration_status": {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "uncertainty_interval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lower",
            "upper"
          ],
          "properties": {
            "lower": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "upper": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "dataset_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "validation_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_hashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "cost_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spread_bps",
            "fees_bps",
            "slippage_bps",
            "net_expected_value",
            "currency"
          ],
          "properties": {
            "spread_bps": {
              "type": "number",
              "minimum": 0
            },
            "fees_bps": {
              "type": "number",
              "minimum": 0
            },
            "slippage_bps": {
              "type": "number",
              "minimum": 0
            },
            "net_expected_value": {
              "type": "number"
            },
            "currency": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "paper_order_proposal"
          }
        },
        "required": [
          "task_type"
        ]
      },
      "then": {
        "required": [
          "scientific_context"
        ],
        "properties": {
          "scientific_context": {
            "required": [
              "method",
              "baseline",
              "event",
              "horizon",
              "probability",
              "calibration_method",
              "calibration_window",
              "calibration_status",
              "uncertainty_interval",
              "model_version",
              "model_hash",
              "dataset_hash",
              "validation_run_id",
              "source_hashes",
              "cost_context",
              "evidence_refs"
            ]
          }
        }
      }
    }
  ]
}
