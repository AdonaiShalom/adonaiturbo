# Safe template for local development. Never commit real credentials.
# Required server-side secret for /v1/chat/completions. If unset, endpoint rejects requests.
# Store the real value in local ignored .env files or hosting-provider encrypted settings.
API_KEY=

# Never place private credentials in NEXT_PUBLIC_* variables; they are browser-visible.
# NEXT_PUBLIC_API_KEY intentionally omitted. Do not expose server API keys to the browser.

# Add only the provider keys you actually use; keep values private.
PROVIDER_OPENROUTER_KEY=
PROVIDER_GOOGLE_KEY=
PROVIDER_GROQ_KEY=
PROVIDER_CEREBRAS_KEY=
PROVIDER_SAMBANOVA_KEY=
PROVIDER_MISTRAL_KEY=
PROVIDER_CLOUDFLARE_KEY=
PROVIDER_GITHUB_KEY=

# Optional site URL used in provider request headers.
NEXT_PUBLIC_SITE_URL=https://example.com
