# Safe template for local development. Never commit real credentials.
# Server-side secret used by API routes; generate a unique value for each environment.
API_KEY=replace-with-a-long-random-server-side-secret

# Do not put API_KEY or any private credential in NEXT_PUBLIC_* variables.
# NEXT_PUBLIC_* values are bundled into browser code and are public.
# NEXT_PUBLIC_API_KEY intentionally omitted; use a server-side session/proxy instead.

# Add only the provider keys you actually use. Keep real values in local .env files
# and in the hosting provider's encrypted environment-variable settings.
PROVIDER_OPENROUTER_KEY=
PROVIDER_GOOGLE_KEY=
PROVIDER_GROQ_KEY=
PROVIDER_CEREBRAS_KEY=
PROVIDER_SAMBANOVA_KEY=
PROVIDER_MISTRAL_KEY=
PROVIDER_CLOUDFLARE_KEY=
PROVIDER_GITHUB_KEY=

# Optional: site URL used in provider request headers.
NEXT_PUBLIC_SITE_URL=https://example.com
